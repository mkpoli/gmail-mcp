{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gmail-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["GmailMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "GmailMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "0d7a73c2d21d40b8beacba9a4b16a7df"
		}
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "gmail-mcp.mkpo.li",
			"custom_domain": true
		}
	]
}
