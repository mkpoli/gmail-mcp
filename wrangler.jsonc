{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gmail-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["GmailMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "GmailMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "0d7a73c2d21d40b8beacba9a4b16a7df"
		}
	],
	"rules": [
		{ "type": "Text", "globs": ["**/*.html"] }
	],
	"vars": {
		// How many distinct Google accounts may ever complete sign-in. Raise it
		// for a shared deployment; Google caps unverified apps at 100 users.
		"MAX_ACCOUNTS": "25",
		// Gmail calls allowed per account per minute, across all its sessions.
		"CALLS_PER_MINUTE": "120"
	},
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 120, "period": 60 }
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "gmail-mcp.mkpo.li",
			"custom_domain": true
		}
	]
}
